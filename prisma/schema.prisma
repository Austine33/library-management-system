enum Role {
  MEMBER
  LIBRARIAN
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String 
  name      String?
  role      Role     @default(MEMBER)

}

model Genre {
  id    Int    @id @default(autoincrement())
  name  String @unique
  books Book[]
}

model Book {
  id            Int      @id @default(autoincrement())
  title         String
  author        String
  isbn          String @unique
  totalCopies   Int
  genreId       Int
  genre         Genre @relation(fields: [genreId], references: [id])
}